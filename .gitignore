# Generated k6 reports — keep domain folders, ignore run output
reports/**
!reports/.gitkeep
!reports/auth/
!reports/blitz/
!reports/exchange/
!reports/auth/.gitkeep
!reports/blitz/.gitkeep
!reports/exchange/.gitkeep

# Local account pool written by the signup suite — keep the folder only
data/*
!data/.gitkeep

# Environment overrides and secrets
.env
.env.*
!.env.example

# Logs and k6 dumps
*.log
*.out
k6-results.*
summary.json

# OS
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editors / IDEs
*.swp
*.swo
*~
.idea/
*.code-workspace

# Node tooling (dotenv-cli loads .env before k6 runs)
node_modules/

# Temp / cache
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
