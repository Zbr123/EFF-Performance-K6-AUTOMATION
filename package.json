{
  "name": "eff-performance-k6-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Grafana k6 performance testing framework for the EFF / E3 AppSync GraphQL API.",
  "main": "main.js",
  "scripts": {
    "signup": "dotenv -- k6 run main.js -e SUITE=signup",
    "login": "dotenv -- k6 run main.js -e SUITE=login",
    "delete": "dotenv -- k6 run main.js -e SUITE=delete-accounts",
    "lifecycle": "dotenv -- k6 run main.js -e SUITE=full-lifecycle",
    "blitz:league": "dotenv -- k6 run main.js -e SUITE=blitz-create-league",
    "blitz:team": "dotenv -- k6 run main.js -e SUITE=blitz-create-team",
    "blitz:owner": "dotenv -- k6 run main.js -e SUITE=blitz-owner-setup",
    "blitz:join": "dotenv -- k6 run main.js -e SUITE=blitz-join-league",
    "blitz:lineup": "dotenv -- k6 run main.js -e SUITE=blitz-create-lineup",
    "blitz:update": "dotenv -- k6 run main.js -e SUITE=blitz-update-lineup",
    "blitz:get-lineup": "dotenv -- k6 run main.js -e SUITE=blitz-get-lineup",
    "blitz:league-details": "dotenv -- k6 run main.js -e SUITE=blitz-league-details",
    "blitz:league-results": "dotenv -- k6 run main.js -e SUITE=blitz-league-results"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "k6",
    "performance-testing",
    "load-testing",
    "graphql",
    "appsync",
    "eff"
  ],
  "author": "",
  "license": "UNLICENSED"
}
